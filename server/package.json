{
  "name": "edufleet-exchange-server",
  "version": "1.0.0",
  "description": "Backend server for EduFleet Exchange - Standalone deployment",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx --watch ./index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "postinstall": "npm run build",
    "lint": "eslint . --ext ts --report-unused-disable-directives",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx ./scripts/seedData/index.ts",
    "seed:accounts": "tsx ./scripts/seedData/accounts.ts",
    "seed:demo": "tsx ./scripts/seedData/demo.ts",
    "seed:prod": "tsx ./scripts/seedData/prod.ts",
    "seed:reset": "tsx ./scripts/seedData/reset.ts && npm run seed"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@sentry/node": "^10.54.0",
    "@sentry/profiling-node": "^10.54.0",
    "@types/node": "^25.0.3",
    "@types/nodemailer": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.0.1",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.8",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sanitize-html": "^2.17.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server": "^10.4.3",
    "nodemon": "^3.1.11",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "vitest": "^2.1.9"
  }
}
