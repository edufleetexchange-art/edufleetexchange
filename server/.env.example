# ============================================================
# eduFleet Exchange — BACKEND env (server/.env)
# Copy to server/.env (gitignored) and fill in real values.
# NEVER commit real secrets — this .example uses placeholders only.
# ============================================================
#
# THREE ENVIRONMENTS — keep their databases separate so local work
# can never wipe production data:
#
#   dev   →  dev cluster, db edu_fleet_exchange_dev   (your local server/.env)
#   test  →  in-memory (mongodb-memory-server) — NO cluster, set nothing
#   prod  →  prod cluster, db edu_fleet_prod          (Render dashboard env vars)
#
# Password special chars MUST be percent-encoded in the URI
# (e.g. '@' → %40, '#' → %23, '/' → %2F, ':' → %3A).
# ============================================================

# --- Server ---
PORT=5000
# dev → development, prod → production. (the test runner sets NODE_ENV=test itself)
NODE_ENV=development
API_PREFIX=/api

# --- Database (per-env DB name; see note above) ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@your-cluster.mongodb.net/edu_fleet_exchange_dev?retryWrites=true&w=majority&appName=Cluster0

# --- Auth (REQUIRED — server refuses to boot without a strong JWT_SECRET) ---
# Generate: openssl rand -hex 32   (min 32 bytes; never the placeholder)
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# --- Frontend URL (CORS, cookies, password-reset links) ---
CLIENT_URL=http://localhost:3000

# --- Email (password-reset / notifications) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_USER=
EMAIL_PASS=

# --- File upload (optional; defaults shown) ---
MAX_FILE_SIZE=5242880
MAX_FILES=10

# --- Observability (optional) ---
SENTRY_DSN=
LOG_LEVEL=info
